{
    "name": "fetsjr/livetabler",
    "description": "Tabler UI components for Livewire, inspired by Flux.",
    "keywords": ["tabler", "laravel", "livewire", "components", "ui"],
    "license": "MIT",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/view": "^10.0|^11.0|^12.0|^13.0",
        "livewire/livewire": "^3.7.4|^4.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0",
        "phpunit/phpunit": "^10.5|^11.0"
    },
    "autoload": {
        "psr-4": {
            "Tabler\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tabler\\Tests\\": "tests/",
            "Tabler\\Workbench\\": "workbench/app/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "serve": "@php vendor/bin/testbench serve"
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "Tabler\\TablerServiceProvider"
            ]
        }
    }
}
